{
    "name": "derafu/symfony-content-bundle",
    "description": "Derafu: Symfony Content Bundle - Content publishing with Symfony",
    "type": "symfony-bundle",
    "homepage": "https://www.derafu.dev/docs/symfony/content-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Esteban De La Fuente Rubio / Derafu",
            "homepage": "https://www.derafu.dev"
        }
    ],
    "support": {
        "issues": "https://github.com/derafu/symfony-content-bundle/issues",
        "source": "https://github.com/derafu/symfony-content-bundle"
    },
    "autoload": {
        "psr-4": {
            "Derafu\\ContentBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Derafu\\TestsContentBundle\\": "tests/src/",
            "Derafu\\TestsContentBundle\\Fixture\\": "tests/fixtures/"
        }
    },
    "require": {
        "php": "^8.5",
        "derafu/array": "dev-main",
        "derafu/content": "dev-main",
        "derafu/http": "dev-main",
        "derafu/markdown": "dev-main",
        "derafu/renderer": "dev-main",
        "derafu/routing": "dev-main",
        "derafu/symfony-translation-bundle": "dev-main",
        "derafu/symfony-twig-components-bundle": "dev-main",
        "derafu/translation": "dev-main",
        "derafu/twig": "dev-main",
        "nyholm/psr7": "^1.8",
        "psr/http-message": "^2.0",
        "symfony/cache": "^8.1",
        "symfony/config": "^8.1",
        "symfony/dependency-injection": "^8.1",
        "symfony/event-dispatcher": "^8.1",
        "symfony/framework-bundle": "^8.1",
        "symfony/http-foundation": "^8.1",
        "symfony/http-kernel": "^8.1",
        "symfony/psr-http-message-bridge": "^8.1",
        "symfony/routing": "^8.1",
        "symfony/translation-contracts": "^3.7",
        "symfony/twig-bundle": "^8.1",
        "symfony/yaml": "^8.1"
    },
    "require-dev": {
        "ext-xdebug": "*",
        "friendsofphp/php-cs-fixer": "^3.95",
        "mcp/sdk": "^0.7",
        "mpdf/mpdf": "^8.3",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^13.4",
        "utopia-php/openapi": "^0.2"
    },
    "scripts": {
        "tests": "XDEBUG_MODE=coverage vendor/bin/phpunit --configuration=phpunit.xml",
        "phpcs-fix": "vendor/bin/php-cs-fixer fix -v --config=php-cs-fixer.php",
        "phpcs": "vendor/bin/php-cs-fixer fix -v --dry-run --diff --config=php-cs-fixer.php",
        "phpstan": "vendor/bin/phpstan analyse --configuration=phpstan.neon --memory-limit=1G",
        "tests-runtime": "php tests/runtime.php"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "suggest": {
        "mpdf/mpdf": "PDF exports",
        "mcp/sdk": "MCP endpoint",
        "utopia-php/openapi": "OpenAPI content"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": false
        }
    }
}
